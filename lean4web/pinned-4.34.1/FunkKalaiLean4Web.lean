  have hb := lensRate_pos hτ0 hτ1
  have hc := lensScale_pos hτ0 hτ1
  have hθ := lensHeightAngle_mem_Ioo hτ0 hτ1 hy
  have hcos := Real.cos_pos_of_mem_Ioo (by simpa [neg_div] using hθ)
