  obtain ⟨a⟩ := exists_sublevelBoundaryAtlas hU hg hc hcl hreg
  obtain ⟨W, ρ, hWo, hCW, _, hρsub, hρc, hsum⟩ :=
    exists_sublevel_partition hU hg.continuousOn hc a
