  exact ((Complex.contDiffAt_log (x := energy f x) (n := r) (by
    rw [energy_eq_tau]; exact Complex.ofReal_mem_slitPlane.mpr (h.tau_pos hx hne))).restrict_scalars ℝ).comp x
    (h.contDiffAt_energy hx r)

