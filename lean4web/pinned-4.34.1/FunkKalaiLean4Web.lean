    (e : OpenPartialHomeomorph (Fin d → ℝ) (Fin d → ℝ)) (H : Set (Fin d → ℝ)) :
    e.symm '' (e.target ∩ H) = e.source ∩ e ⁻¹' H := by
  ext x
  constructor
  · rintro ⟨y, ⟨hyt, hyH⟩, rfl⟩
    refine ⟨e.map_target hyt, ?_⟩
    change e (e.symm y) ∈ H
    rw [e.right_inv hyt]
