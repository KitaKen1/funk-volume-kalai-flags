      Finset.measurable_prod Finset.univ (fun i _ => (hf (Fin.succ i)).comp (measurable_pi_apply i))
    rw [lintegral_prod_mul (μ := μ 0) (ν := Measure.pi (fun i : Fin n => μ (Fin.succ i)))
