  have hn : 0 ≤ᵐ[volume.restrict (coordinateBox n (-τ) τ)]
      (fun x => (∏ i, cubeKernel (x i)) / (n.factorial : ℝ)) := by
    filter_upwards [ae_restrict_mem (μ := volume) (measurableSet_coordinateBox n (-τ) τ)]
