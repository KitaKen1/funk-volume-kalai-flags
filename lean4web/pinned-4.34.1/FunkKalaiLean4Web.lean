/-- The scalar factor in the derivative of the kth inverse-coordinate power. -/
def lensPowerRowFactor {n m : ℕ} (τ : ℝ) (rows : Fin m → Space n) (k : ℕ)
    (z : LensComplexSpace n) (j : Fin m) : ℂ :=
