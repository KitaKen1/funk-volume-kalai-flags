    (hP : IsSymmetricConvexBody P) {τ a : ℝ} (hτ0 : 0 < τ) (hτ1 : τ < 1) :
    ENNReal.ofReal a ≤ funkVolume P τ ↔ a ≤ (funkVolume P τ).toReal :=
  ENNReal.ofReal_le_iff_le_toReal
    (funkVolume_symmetricConvexBody_finite hP hτ0 hτ1).ne

