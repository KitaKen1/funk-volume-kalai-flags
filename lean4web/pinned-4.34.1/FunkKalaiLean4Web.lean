    exact (S.orderEmbOfFin (Finset.mem_powersetCard.mp hS).2).strictMono
  · intro S hS T hT he
    have h := congrArg (fun f : Fin n → Fin m => Finset.univ.image f) he
    simpa only [Finset.image_orderEmbOfFin_univ] using h
