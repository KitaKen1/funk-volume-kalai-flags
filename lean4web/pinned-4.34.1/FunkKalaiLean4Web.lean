    ((fullChainRankEquiv s hs hc).symm (Fin.last n)).val.property.1
    ((fullChainRankEquiv s hs hc).symm (Fin.last n)).val.property.2
    (hs.1 _ ((fullChainRankEquiv s hs hc).symm (Fin.last n)).property)
