  intro i j hij
  have hv : Set.range (fun k => dualCoordinates (flagMatrix G) (τ • flagPoint F k)) ⊆
      {u : Space n | a j * u (σ j) ≤ a i * u (σ i)} := by
    rintro _ ⟨k, rfl⟩
    exact flagOrderCertificate_scaled_vertices hc hτ0 hτ1 k i j hij
