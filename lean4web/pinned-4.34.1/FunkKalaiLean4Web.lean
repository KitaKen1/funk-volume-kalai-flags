    apply chartBoundaryFlux_congr
    intro x _ hxlevel
    by_cases hz : ρ (some i) x = 0
    · simp [hz]
    · have hxU : x ∈ U := (a.patch i).domain_U (hρsub (some i) (subset_tsupport (ρ (some i)) hz))
