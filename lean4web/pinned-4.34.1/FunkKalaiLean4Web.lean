    (h2 : TendstoUniformlyOn (fun r => fderiv ℝ (fderiv ℝ (rescaledLog (tau f) m r)))
      (fderiv ℝ (fderiv ℝ (logTau (polynomialMap G)))) (𝓝[>] 0) (sphereAnnulus (k+1))) :
    Tendsto (smallSphereFlux k (logTau f)) (𝓝[>] 0)
