    volume (orderedLogSimplex (n + 1) r) =
      ∫⁻ t in Icc 0 r, volume (orderedLogSimplex n t) := by
  let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm
  have hp := (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm
