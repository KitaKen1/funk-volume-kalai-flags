  (Equiv.sumCongr (Equiv.refl (Fin 1)) (powerFinEquiv k)).trans
    (finSumFinEquiv.trans (finCongr (by omega)))

def ambientFinEquiv (k : ℕ) : WedgePowerSlots (k+1) ≃ Fin ((2*k+1)+1) :=
  (powerFinEquiv (k+1)).trans (finCongr (by omega))

