    (ρ : ι → (Fin d → ℝ) → ℝ)
    (ω : (Fin d → ℝ) → (Fin d → ℝ) [⋀^Fin n]→L[ℝ] ℝ) (i : ι)
    (hρ : HasCompactSupport (ρ i)) : HasCompactSupport (fun x => ρ i x • ω x) := by
  exact hρ.of_isClosed_subset (isClosed_tsupport _) (tsupport_smul_subset_left _ _)

