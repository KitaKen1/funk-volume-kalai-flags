  constructor
  · intro h ε hε
    obtain ⟨R, hR, hb⟩ := h ε hε
    refine ⟨R, hR, ?_⟩
    exact (ENNReal.le_ofReal_iff_toReal_le
      (funkVolume_symmetricConvexBody_finite hP (radius_pos hR) (radius_lt_one R)).ne
      (by positivity)).mp hb
  · intro h ε hε
    obtain ⟨R, hR, hb⟩ := h ε hε
    refine ⟨R, hR, ?_⟩
    exact (ENNReal.le_ofReal_iff_toReal_le
      (funkVolume_symmetricConvexBody_finite hP (radius_pos hR) (radius_lt_one R)).ne
      (by positivity)).mpr hb

