theorem intrinsicFrontier_mem_properFace {n : ℕ} {C : Set (Space n)}
    (hk : IsCompact C) (hc : Convex ℝ C) (hn : C.Nonempty)
    {x : Space n} (hx : x ∈ intrinsicFrontier ℝ C) :
    ∃ F : PolytopeFace C, F.val.Nonempty ∧ F.val ≠ C ∧ x ∈ F.val := by
