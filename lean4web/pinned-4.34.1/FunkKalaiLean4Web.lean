 theorem integral_partial_univ {n : ℕ} (i : Fin (n+1))
    {f : (Fin (n+1) → ℝ) → ℝ} (hf : ContDiff ℝ 1 f) (hc : HasCompactSupport f) :
    (∫ x, fderiv ℝ f x (Pi.single i 1)) = 0 := by
