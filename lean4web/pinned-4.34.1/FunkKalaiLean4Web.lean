    {F : FullFlagWithTop P} {G : FullFlagWithTop (coordinatePolar P)}
    {σ : Equiv.Perm (Fin n)} {a : Space n} (hc : FlagOrderCertificate F G σ a)
    {τ : ℝ} (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1)
