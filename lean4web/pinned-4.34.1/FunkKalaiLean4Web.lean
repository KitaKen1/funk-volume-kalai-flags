  filter_upwards [hae] with x hx
  apply propext
  change (radiusSq x < R^2 ∧ ¬radiusSq x < a^2) ↔
    (radiusSq x < R^2 ∧ ¬radiusSq x ≤ a^2)
  have hn : radiusSq x ≠ a^2 := hx
