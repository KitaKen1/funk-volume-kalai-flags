    (hreg : ∀ x ∈ U, g x = R → fderiv ℝ g x ≠ 0) :
    IsCompact (U ∩ {x | g x = R}) := by
  rw [← frontier_regularSublevel hU hg hcl hreg]
  exact hc.of_isClosed_subset isClosed_frontier frontier_subset_closure

