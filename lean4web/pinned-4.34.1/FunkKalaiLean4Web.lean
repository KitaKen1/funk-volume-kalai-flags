  rw [mem_coordinateBox]
  intro i
  have hgap : 0 < 1 - τ := by linarith
  have htest (a : ℝ) (ha : |a| ≤ 1 - τ) :
      Pi.single i a ∈ translate (coordinateCube n) x := by
    refine ⟨x + Pi.single i a, ?_, by simp⟩
    rw [mem_coordinateCube]
    intro j
    by_cases hji : j = i
