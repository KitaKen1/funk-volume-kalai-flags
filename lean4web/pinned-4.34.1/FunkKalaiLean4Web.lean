  rw [← expCoordinates_image_dualLogDomain hp hP hτ0 hτ1 F G]
  exact lintegral_expCoordinates_kernel (dualLogDomain_measurableSet τ F G)

theorem dualLogDomain_radius_bounds {n : ℕ} {P : Set (Space n)}
