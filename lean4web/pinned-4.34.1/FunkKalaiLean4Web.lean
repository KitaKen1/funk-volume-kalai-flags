    (hω : ContDiffOn ℝ 1 ω (U \ {0})) :
    ∃ (a : RegularBoundaryAtlas (n+1) U g (frontier (regularSublevel U g R)))
      (W : Set (Fin (n+1) → ℝ))
      (ρ : SmoothPartitionOfUnity (Option a.Index) 𝓘(ℝ, Fin (n+1) → ℝ)
