  obtain ⟨i, j, hij, hi, hj⟩ := extra_row_coefficients_two_nonzero rows hirr s hB ha ha0
  refine ⟨i, j, hij, branchCollisionMixedDeriv_ne_zero hτ0 hτ1 b σ _ _ i j hij hi hj ?_ ?_⟩
