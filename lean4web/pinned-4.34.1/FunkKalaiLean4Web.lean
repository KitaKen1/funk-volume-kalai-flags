lemma wedge_triple_power_order [NormedSpace ℂ E] [IsScalarTower ℝ ℂ E]
    [FiniteDimensional ℝ E] (basis : Module.Basis J ℝ E) (k : ℕ)
    (c : E [⋀^Fin 1]→ₗ[ℝ] ℂ) (D A : E [⋀^Fin 2]→ₗ[ℝ] ℂ) :
