theorem body_subset_flagSimplices {n : ℕ} {P : Set (Space n)}
    (hp : IsFinitePolytope P) (hP : IsSymmetricConvexBody P) :
    P ⊆ ⋃ F : FullFlagWithTop P, flagSimplex F := by
  let : Finite (FullFlagWithTop P) := fullFlagWithTop_finite hp hP
