    (isOpen_interior.inter hC.isOpen_compl).eq_empty_of_measure_zero hnull
  have hi : interior D ⊆ C := by
    intro x hx
    by_contra hn
    have hm : x ∈ interior D ∩ Cᶜ := ⟨hx, hn⟩
    rw [hempty] at hm
    exact hm
  exact hD.trans (closure_minimal hi hC)

