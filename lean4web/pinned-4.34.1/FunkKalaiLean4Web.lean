def densityBridgeSlots (k : ℕ) :
    (Fin 1 ⊕ (Fin 1 ⊕ WedgePowerSlots k)) ≃ Fin ((2*k+1)+1) :=
  (sphereFrameSlots k).trans (ambientFinEquiv k)

