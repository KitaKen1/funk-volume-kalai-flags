theorem F_chord_re_pos {a b : ℂ} (ha : ‖a‖ < 1) (hb : ‖b‖ < 1)
    (hab : a ≠ b) : 0 < ((F b - F a) / (b-a)).re := by
  have hd : b-a ≠ 0 := sub_ne_zero.mpr (Ne.symm hab)
  let g : ℝ → ℝ := fun t => (F (a+(t : ℂ)*(b-a))/(b-a)).re
