  have hc := (hasDerivAt_lensBranchProfileSlope hτ0 hτ1 σ ht).comp_of_eq (t j)
    (hasDerivAt_dotProduct_update coeff t j (t j)) (by simp)
  have hd := ((hasDerivAt_const (t j) (lensBranchProfileSlope τ (b i) (t i))).sub hc).const_mul
