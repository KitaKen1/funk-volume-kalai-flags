      -((k+1 : ℕ) : ℂ) * extDeriv (homogeneousPrimitive (m := m) G t) x v := by
  let a := alphaPath (polynomialMap G) (coordinateMap (k+2)) m t
  let b := betaLinear (polynomialMap G) (coordinateMap (k+2)) m
