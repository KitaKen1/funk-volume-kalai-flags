    {x : I → ℝ | ∀ j, |∑ i, (a j).val i * x i| ≤ 1} = K := by
  ext x
  constructor
  · intro hx
    by_contra hxK
    obtain ⟨p, hp, hpx⟩ := exists_coordinatePolar_separator hconv hclosed hzero hxK
    let C : Set (coordinatePolar K) := {q | (∑ i, q.val i * x i) ≤ 1}
