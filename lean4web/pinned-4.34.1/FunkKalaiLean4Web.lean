theorem canonical_probability_sum_eq_unsigned {n m : ℕ}
    {τ : ℝ} (hτ0 : 0 < τ) (hτ1 : τ < 1) (rows : Fin m → Space n) :
    (∑ k ∈ canonicalBasisIndices rows, lensBoundaryRows n τ
      (basisBoundaryEvent τ k.2 (fun i => rows (k.1 i))
