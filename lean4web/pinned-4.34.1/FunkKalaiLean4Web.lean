  simpa using one_sub_ne (w := -w) (by simpa using hw)

lemma one_sub_sq_ne {w : ℂ} (hw : ‖w‖ < 1) : 1-w^2 ≠ 0 := by
  apply one_sub_ne
  rw [norm_pow]
  nlinarith [norm_nonneg w]

