    lensJetTerm b j z = lensTermDeriv b (j + 1) z + z ^ 2 * lensTermDeriv b j z := by
  rw [lensJetTerm, lensJetCoeff_eq_sub, lensTermDeriv_eq, lensTermDeriv_eq]
  simp only [show 2 * (j + 1) = 2 * j + 2 by omega, pow_succ]
  ring

