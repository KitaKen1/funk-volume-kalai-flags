  rw [Ω.map_update_sum, Finset.sum_eq_single i]
  · rw [Ω.map_update_smul, Function.update_eq_self]
    rfl
  · intro j hj hji
    rw [Ω.map_update_smul, Ω.map_update_self _ hji.symm, smul_zero]
  · simp

