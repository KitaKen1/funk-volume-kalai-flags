    Function.Injective (basisMap B) := by
  change Function.Injective B.mulVec
  exact Matrix.mulVec_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det B).mpr
    (isUnit_iff_ne_zero.mpr hB))

