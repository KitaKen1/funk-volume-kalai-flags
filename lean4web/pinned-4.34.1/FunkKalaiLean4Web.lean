lemma continuous_pairing (x : I → ℝ) : Continuous (fun p : I → ℝ => ∑ i, p i * x i) := by
  exact continuous_finsetSum _ (fun i _ => (continuous_apply i).mul continuous_const)

lemma coordinatePolar_antitone {K L : Set (I → ℝ)} (h : K ⊆ L) :
