  rw [basisBoundaryEvent, lensBoundaryRows_region hτ0 hτ1 b (measurableSet_basisMap_image hB hs),
    inter_eq_left.mpr (basisMap_image_subset_cube B hsub), lintegral_basisMap_image hB hs]

