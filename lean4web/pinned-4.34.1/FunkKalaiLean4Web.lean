  apply setLIntegral_mono' (measurableSet_coordinateBox n (-τ) τ)
  intro x hx
  obtain ⟨X, hX, rfl⟩ := (scaled_coordinateCube hτ₀).symm ▸ hx
  simpa [cubeKernel, Pi.smul_apply, smul_eq_mul] using
    cube_polar_volume_lower hτ₀.le hτ₁ hX


