/-- A one-sided FVW envelope for the exact volume and exact frozen flag count. -/
def FVWEpsilonUpper {n : ℕ} (P : Set (Space n)) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ R : ℝ, 0 < R ∧
    funkVolume P (radius R) ≤ ENNReal.ofReal
      (((Nat.card (FullFlag P) : ℝ) / (n.factorial : ℝ) ^ 2 + ε) * R ^ n)

