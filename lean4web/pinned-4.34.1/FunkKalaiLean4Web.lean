 theorem setIntegral_extDeriv_congr_support {n : ℕ} {s t : Set (Fin (n+1) → ℝ)}
    (ω : (Fin (n+1) → ℝ) → (Fin (n+1) → ℝ) [⋀^Fin n]→L[ℝ] ℝ)
