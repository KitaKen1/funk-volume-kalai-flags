  let : Finite (FacetPolytopeFace P) := facetPolytopeFace_finite hp
  let : Fintype (FacetPolytopeFace P) := Fintype.ofFinite (FacetPolytopeFace P)
  rw [funkVolume_scale hP.1.measurableSet hτ]
